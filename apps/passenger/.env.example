# Copy to .env.local and fill in from the Supabase dashboard.
# See /.env.example.md at the repo root for details on each variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Do NOT prefix with NEXT_PUBLIC_. Only needed if this app
# ever calls getSupabaseAdminClient() — Passenger currently doesn't.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps (Phase 9) — see /.env.example.md and PHASE_9_MAPS_LOCATION_LIVE_TRACKING_REVIEW.md ---
# Client-side, Maps JS API rendering only. Restrict this key by HTTP
# referrer in Google Cloud Console before using it anywhere but local dev.
# App runs fine without it — falls back to the demo map (see @ride-it/maps).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. A real Map ID (Google Cloud Console > Maps > Map IDs) is
# required for AdvancedMarkerElement styling in production. Falls back to
# Google's public "DEMO_MAP_ID" placeholder if unset — fine for local dev,
# not for production (unstyled default map).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server-only. Used by app/api/geocode/route.ts to turn a destination
# address into coordinates at booking-confirm time (once per booking, not
# per keystroke — no autocomplete API is used).
GOOGLE_MAPS_GEOCODING_API_KEY=

# Server-only. Used by app/api/eta/route.ts for throttled ETA/distance
# display via the Routes API.
GOOGLE_MAPS_ROUTES_API_KEY=

# --- Payments (Phase 11) — see PHASE_11_PAYMENTS_FINANCIAL_INTEGRITY_REVIEW.md ---
# RAZORPAY_KEY_ID is also returned (not the secret) to the browser via
# /api/payments/create-order — this is the intended, standard usage of
# that specific key (Razorpay's Checkout.js requires it client-side).
RAZORPAY_KEY_ID=
# Server-only. Never sent to the browser.
RAZORPAY_KEY_SECRET=
# Server-only. Used only by app/api/payments/webhook/route.ts.
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase Cloud Messaging (push notifications) — see /.env.example.md ---
# All six of these are the public Web SDK config Firebase itself expects
# to ship in client bundles (not secrets — protected by Firebase's own
# project/App Check rules, not by keeping them hidden). Get them from
# Firebase Console > Project settings > General > Your apps > Web app.
# App runs fine without them — the push-notification UI simply doesn't
# render (see components/push-notification-settings.tsx).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Also public by design (it's the public half of the Web Push key pair).
# Firebase Console > Project settings > Cloud Messaging > Web configuration.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Development-only E2E auth bootstrap (Phase 20). See
# packages/supabase/src/e2e.ts and PHASE_20_E2E_VALIDATION_REPORT.md.
# Leave unset (or "false") everywhere except a local/dev environment
# you control. MUST be unset/false in any production deployment.
RIDE_IT_E2E_TEST_MODE=false
# Real Supabase Auth sign-in now uses EMAIL + PASSWORD (not phone) so no
# SMS provider (Twilio/Vonage/MessageBird/TextLocal) is required for
# E2E testing. Use a reserved test-only domain, e.g. e2e-passenger@ride-it.test.
RIDE_IT_E2E_PASSENGER_EMAIL=
RIDE_IT_E2E_PASSENGER_PASSWORD=
# Still required, but NOT used for sign-in any more: a deterministic
# 10-digit test phone number so handle_new_auth_user() correctly infers
# role=passenger instead of falling through to its admin-inference
# branch (see packages/supabase/src/e2e.ts's header comment for why).
RIDE_IT_E2E_PASSENGER_PHONE=
RIDE_IT_E2E_DRIVER_EMAIL=
RIDE_IT_E2E_DRIVER_PASSWORD=
RIDE_IT_E2E_DRIVER_PHONE=
