# Copy to .env.local and fill in from the Supabase dashboard.
# Marketing only ever reads public, anon-grantable data (the homepage's
# "successful rides" counter, via get_public_ride_stats() — see
# supabase/migrations/20260908090000_public_ride_stats.sql and
# lib/ride-stats.ts) so only the anon key is needed here, never the
# service-role key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
