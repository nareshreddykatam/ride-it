# Copy to .env.local and fill in from the Supabase dashboard.
# See /.env.example.md at the repo root for details on each variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Do NOT prefix with NEXT_PUBLIC_. The Admin app is the most
# likely place to eventually use getSupabaseAdminClient() (e.g. approving
# driver documents server-side) — keep this key out of version control.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps (Phase 9) — see /.env.example.md and PHASE_9_MAPS_LOCATION_LIVE_TRACKING_REVIEW.md ---
# Rendering only — Admin's Ride Detail map display. No geocoding/routes
# keys needed here; Admin never geocodes an address or requests an ETA.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Payments (Phase 11) — see PHASE_11_PAYMENTS_FINANCIAL_INTEGRITY_REVIEW.md ---
# Used only by app/api/payments/refund/route.ts to call the gateway's
# real refund API. No webhook secret needed here — the canonical webhook
# endpoint lives in the Passenger app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
