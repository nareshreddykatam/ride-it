{
  "name": "ride-it",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:passenger": "turbo run dev --filter=@ride-it/passenger",
    "dev:driver": "turbo run dev --filter=@ride-it/driver",
    "dev:admin": "turbo run dev --filter=@ride-it/admin",
    "dev:marketing": "turbo run dev --filter=@ride-it/marketing",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "supabase": "^2.114.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
